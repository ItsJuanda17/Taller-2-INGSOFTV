@groovy.transform.Field
final List<Map> SERVICES = [
    [name: 'circleguard-auth-service',         deployment: 'auth-service',         port: '8180', smokePath: '/api/v1/auth/qr/generate', smokeMethod: 'GET',  smokeBody: '' ],
    [name: 'circleguard-identity-service',     deployment: 'identity-service',     port: '8083', smokePath: '/api/v1/identities/visitor', smokeMethod: 'POST', smokeBody: '{"name":"smoke","email":"s@x.org","reason_for_visit":"ci"}' ],
    [name: 'circleguard-promotion-service',    deployment: 'promotion-service',    port: '8088', smokePath: '/api/v1/buildings', smokeMethod: 'GET',  smokeBody: '' ],
    [name: 'circleguard-dashboard-service',    deployment: 'dashboard-service',    port: '8084', smokePath: '/api/v1/analytics/health-board', smokeMethod: 'GET',  smokeBody: '' ],
    [name: 'circleguard-gateway-service',      deployment: 'gateway-service',      port: '8087', smokePath: '/api/v1/gate/validate', smokeMethod: 'POST', smokeBody: '{"token":"invalid"}' ],
    [name: 'circleguard-notification-service', deployment: 'notification-service', port: '8082', smokePath: '',                                smokeMethod: 'TCP',  smokeBody: '' ],
]

pipeline {
    agent any

    options {
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    environment {
        NAMESPACE       = 'circleguard'
        VERSION         = "1.0.${env.BUILD_NUMBER}"
        RELEASE_TAG     = "v${VERSION}"
        IMAGE_TAG       = "master-${VERSION}"
        KUBECONFIG      = "/var/jenkins_home/.kube/config"
        LOCUST_USERS    = '30'
        LOCUST_SPAWN    = '5'
        LOCUST_DURATION = '5m'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Prepare (warm Gradle)') {
            steps {
                sh '''
                    chmod +x ./gradlew
                    ./gradlew --version --no-daemon --console=plain
                '''
            }
        }

        stage('Build & Test (sequential)') {
            steps {
                script {
                    SERVICES.each { svc ->
                        stage("test:${svc.deployment}") {
                            sh "./gradlew :services:${svc.name}:bootJar -x test --no-daemon --console=plain"
                            try {
                                sh "./gradlew :services:${svc.name}:test --no-daemon --console=plain"
                            } finally {
                                junit allowEmptyResults: false,
                                      testResults: "services/${svc.name}/build/test-results/test/*.xml"
                            }
                        }
                    }
                }
            }
        }

        stage('Docker build (parallel)') {
            steps {
                script {
                    def branches = [:]
                    SERVICES.each { svc ->
                        branches["docker:${svc.deployment}"] = {
                            sh """
                                docker build \\
                                  -f services/${svc.name}/Dockerfile \\
                                  -t ${svc.name}:${IMAGE_TAG} \\
                                  -t ${svc.name}:master \\
                                  -t ${svc.name}:dev \\
                                  .
                            """
                        }
                    }
                    parallel branches
                }
            }
        }

        stage('Deploy to K8s (parallel)') {
            steps {
                script {
                    def branches = [:]
                    SERVICES.each { svc ->
                        branches["deploy:${svc.deployment}"] = {
                            sh """
                                set -e
                                kubectl --kubeconfig=${KUBECONFIG} apply -f infra/k8s/services/${svc.deployment}.yaml
                                kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} \\
                                  set image deployment/${svc.deployment} ${svc.deployment}=${svc.name}:${IMAGE_TAG}
                                if ! kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} \\
                                       rollout status deployment/${svc.deployment} --timeout=8m ; then
                                    echo '----- FAILURE DIAGNOSTICS for ${svc.deployment} -----'
                                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} get pods -l app=${svc.deployment} -o wide || true
                                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} describe deployment/${svc.deployment} || true
                                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} describe pods -l app=${svc.deployment} || true
                                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} logs -l app=${svc.deployment} --tail=80 --all-containers || true
                                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} get events --sort-by=.lastTimestamp | tail -40 || true
                                    exit 1
                                fi
                            """
                        }
                    }
                    parallel branches
                }
            }
        }

        stage('Smoke (parallel)') {
            steps {
                script {
                    def branches = [:]
                    SERVICES.each { svc ->
                        branches["smoke:${svc.deployment}"] = {
                            if (svc.smokeMethod == 'TCP') {
                                sh """
                                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} \\
                                      run smoke-master-${svc.deployment}-${BUILD_NUMBER} \\
                                      --image=curlimages/curl --restart=Never --rm -i --quiet \\
                                      --command -- \\
                                      sh -c "nc -z ${svc.deployment}.${NAMESPACE}.svc.cluster.local ${svc.port} && echo OK"
                                """
                            } else if (svc.smokeMethod == 'GET') {
                                sh """
                                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} \\
                                      run smoke-master-${svc.deployment}-${BUILD_NUMBER} \\
                                      --image=curlimages/curl --restart=Never --rm -i --quiet \\
                                      --command -- \\
                                      curl -s -o /dev/null -w "HTTP %{http_code} from ${svc.deployment}\\n" \\
                                      --max-time 5 \\
                                      http://${svc.deployment}.${NAMESPACE}.svc.cluster.local:${svc.port}${svc.smokePath}
                                """
                            } else {
                                sh """
                                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} \\
                                      run smoke-master-${svc.deployment}-${BUILD_NUMBER} \\
                                      --image=curlimages/curl --restart=Never --rm -i --quiet \\
                                      --command -- \\
                                      curl -s -o /dev/null -w "HTTP %{http_code} from ${svc.deployment}\\n" \\
                                      --max-time 5 \\
                                      -H "Content-Type: application/json" \\
                                      -d '${svc.smokeBody}' \\
                                      http://${svc.deployment}.${NAMESPACE}.svc.cluster.local:${svc.port}${svc.smokePath}
                                """
                            }
                        }
                    }
                    parallel branches
                }
            }
        }

        stage('E2E (REST Assured) — strict') {
            steps {
                sh '''
                    set -e
                    JWT="$(kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} get secret circleguard-secrets -o jsonpath='{.data.JWT_SIGNING_KEY}' | base64 -d)"

                    trap 'kill $(jobs -p) 2>/dev/null || true' EXIT
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} port-forward svc/auth-service         30180:8180 > /dev/null 2>&1 &
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} port-forward svc/identity-service     30083:8083 > /dev/null 2>&1 &
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} port-forward svc/promotion-service    30088:8088 > /dev/null 2>&1 &
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} port-forward svc/dashboard-service    30084:8084 > /dev/null 2>&1 &
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} port-forward svc/gateway-service      30087:8087 > /dev/null 2>&1 &
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} port-forward svc/notification-service 30082:8082 > /dev/null 2>&1 &
                    sleep 6

                    AUTH_URL=http://localhost:30180 \
                    IDENTITY_URL=http://localhost:30083 \
                    PROMOTION_URL=http://localhost:30088 \
                    DASHBOARD_URL=http://localhost:30084 \
                    GATEWAY_URL=http://localhost:30087 \
                    NOTIFICATION_URL=http://localhost:30082 \
                    JWT_SECRET="${JWT}" \
                    ./gradlew :tests:e2e:test --no-daemon --console=plain
                '''
            }
            post {
                always {
                    junit allowEmptyResults: false,
                          testResults: 'tests/e2e/build/test-results/test/*.xml'
                }
            }
        }

        stage('Performance test (Locust)') {
            steps {
                sh '''
                    set -e
                    docker build -f tests/performance/Dockerfile -t circleguard-locust:master .
                    rm -rf locust-reports && mkdir -p locust-reports

                    POD=locust-master-${BUILD_NUMBER}
                    JWT="$(kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} get secret circleguard-secrets -o jsonpath='{.data.JWT_SIGNING_KEY}' | base64 -d)"

                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} delete pod ${POD} --ignore-not-found

                    set +e
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} run ${POD} \
                      --image=circleguard-locust:master \
                      --image-pull-policy=IfNotPresent \
                      --restart=Never \
                      -i --attach \
                      --env=JWT_SECRET="${JWT}" \
                      --env=CIRCLEGUARD_AUTH_SERVICE_URL=http://auth-service.${NAMESPACE}.svc.cluster.local:8180 \
                      --env=CIRCLEGUARD_IDENTITY_SERVICE_URL=http://identity-service.${NAMESPACE}.svc.cluster.local:8083 \
                      --env=CIRCLEGUARD_PROMOTION_SERVICE_URL=http://promotion-service.${NAMESPACE}.svc.cluster.local:8088 \
                      --env=CIRCLEGUARD_DASHBOARD_SERVICE_URL=http://dashboard-service.${NAMESPACE}.svc.cluster.local:8084 \
                      --env=CIRCLEGUARD_GATEWAY_SERVICE_URL=http://gateway-service.${NAMESPACE}.svc.cluster.local:8087 \
                      -- \
                      -u ${LOCUST_USERS} -r ${LOCUST_SPAWN} -t ${LOCUST_DURATION} \
                      --csv /tmp/master --html /tmp/master.html
                    EXIT=$?
                    set -e

                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} cp ${POD}:/tmp/master.html               locust-reports/master.html               || true
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} cp ${POD}:/tmp/master_stats.csv          locust-reports/master_stats.csv          || true
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} cp ${POD}:/tmp/master_failures.csv       locust-reports/master_failures.csv       || true
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} cp ${POD}:/tmp/master_stats_history.csv  locust-reports/master_stats_history.csv  || true
                    kubectl --kubeconfig=${KUBECONFIG} -n ${NAMESPACE} delete pod ${POD} --ignore-not-found
                    exit ${EXIT}
                '''
                archiveArtifacts artifacts: 'locust-reports/**', allowEmptyArchive: true
            }
        }

        stage('Generate release notes') {
            steps {
                sh '''
                    docker run --rm -v "${WORKSPACE}:/work" -w /work \\
                      orhunp/git-cliff:latest \\
                      --tag ${RELEASE_TAG} \\
                      --unreleased \\
                      -o RELEASE_NOTES.md
                    echo "===== RELEASE_NOTES.md ====="
                    cat RELEASE_NOTES.md
                '''
                archiveArtifacts artifacts: 'RELEASE_NOTES.md', allowEmptyArchive: false
            }
        }

        stage('Tag release') {
            steps {
                sh '''
                    git tag -a ${RELEASE_TAG} -m "Release ${RELEASE_TAG} (build ${BUILD_NUMBER})" || true
                    git tag --list ${RELEASE_TAG}
                '''
            }
        }
    }

    post {
        success { echo "MASTER pipeline succeeded - ${RELEASE_TAG}" }
        failure { echo "MASTER pipeline failed at build #${BUILD_NUMBER}" }
        always  { sh 'docker image prune -f --filter "dangling=true" || true' }
    }
}
